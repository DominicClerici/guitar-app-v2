# Copy to `.env.local` to override the API base URL. It is used for both tRPC and auth, so the two
# always agree on an origin — see src/lib/api/baseUrl.ts.
# When unset, the app targets `wrangler dev` on port 8788 at whatever host Metro is served from.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Google sign-in. Both come from Google Cloud's OAuth clients and are read at build time by
# app.config.ts and at runtime by src/lib/auth/social.ts. With either unset the Google button is
# hidden and the native module is left out of the build entirely — Apple and email still work.
#
# Paste each id exactly as Google shows it. The iOS URL scheme is the client id reversed, and
# app.config.ts does that rewriting itself — there is no third variable to set.
#
# The *web* client id is what the server verifies the resulting token against, even on a device,
# so it must match GOOGLE_CLIENT_ID in the Worker's .dev.vars.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-abcdefghijklmnop.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-qrstuvwxyz.apps.googleusercontent.com

{
  "name": "guitar-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "api": "pnpm --filter @guitar/api",
    "db": "pnpm --filter @guitar/db",
    "content": "pnpm --filter @guitar/content",
    "content:publish": "pnpm --filter @guitar/content run content:publish",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}

# Copy to `.dev.vars` (gitignored) for local `wrangler dev`.
# In deployed environments these are set with `wrangler secret put <NAME> --env <staging|production>`.

# Local development: the containers from `pnpm db db:up`. A local host here makes the driver route
# through the HTTP proxy on :4445 instead of reaching for Neon.
DATABASE_URL=postgres://guitar:guitar@localhost:5434/guitar

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:8788

# Sign in with Apple. The bundle id is the only one the app needs: it signs in natively, and the
# identity token that arrives is issued against the bundle id, which is what the server verifies
# it against. Set it and the Apple button works.
#
# The other two are the browser redirect flow, which nothing in the app starts yet. CLIENT_ID is a
# Services identifier (not the bundle id) and CLIENT_SECRET is an ES256 JWT you sign yourself with
# a .p8 key from the Apple developer portal — it expires after at most six months and has to be
# regenerated. Leave both empty until a browser signs in.
APPLE_APP_BUNDLE_IDENTIFIER=com.dominicrumor.guitar-mobile-expo
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for email verification, password reset, and the sign-in code. With either of these unset,
# links and codes are logged to the console instead of sent, so email sign-up works locally without
# a Resend account.
RESEND_API_KEY=
EMAIL_FROM=Guitar App <noreply@example.com>

# Twilio, for the phone sign-in code. With any of these unset the code is logged to the console
# instead of sent, so phone sign-up works locally without a Twilio account. The number is the one
# messages are sent from, in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Guest accounts are not configured here — ENABLE_ANONYMOUS_AUTH is not a secret and lives in
# wrangler.jsonc. Setting it in this file would override that and silently disable them locally.

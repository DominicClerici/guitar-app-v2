{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guitar-api",
  "main": "src/index.ts",
  // Cannot exceed the newest date the installed workerd binary supports, or local dev and the
  // vitest pool both refuse to start. Bump it alongside wrangler.
  "compatibility_date": "2026-08-08",
  // Better Auth and Drizzle both reach for Node built-ins (crypto, buffer, async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Change this and WRANGLER_DEV_PORT in the Expo app's src/lib/api/baseUrl.ts together.
  // Deliberately not Wrangler's default 8787: macOS's Photos daemon listens on it, and because it
  // binds the IPv6 wildcard it wins `localhost` over workerd's loopback bind. The symptom is a
  // worker that appears to run while every request is answered by photod — /health even returns a
  // plausible {"ok":true}. Reach it on 127.0.0.1 explicitly if a port ever has to be shared again.
  // `ip` because Wrangler otherwise binds loopback only, so a physical device on the LAN gets a
  // connection refused with nothing reaching the worker — no request log to explain it.
  "dev": { "port": 8788, "ip": "0.0.0.0" },

  "vars": {
    // Comma-separated. Better Auth checks this list for OAuth redirects and cookie handling,
    // and it drives the CORS allowlist — the Expo scheme must be here or sign-in fails silently.
    "TRUSTED_ORIGINS": "guitarmobileexpo://,http://localhost:8088,http://localhost:8081",
    // Guest accounts (BACKEND_PLAN.md §5). Set to "false" to stop new ones being created; the app
    // then shows the sign-in forms instead, with no deploy of its own. Note that per-environment
    // `vars` below replace this block rather than merging into it, so each one repeats it.
    "ENABLE_ANONYMOUS_AUTH": "true",
  },

  // Session cache and rate limiting live in KV so per-request session lookups stay off Neon
  // (BACKEND_PLAN.md §5). Uncomment once the namespaces exist:
  //   wrangler kv namespace create SESSION_KV
  //   wrangler kv namespace create SESSION_KV --preview
  // "kv_namespaces": [
  //   { "binding": "SESSION_KV", "id": "<id>", "preview_id": "<preview-id>" }
  // ],

  "env": {
    "staging": {
      "name": "guitar-api-staging",
      "vars": {
        "TRUSTED_ORIGINS": "guitarmobileexpo://,https://staging.example.com",
        "ENABLE_ANONYMOUS_AUTH": "true",
      },
      // "kv_namespaces": [{ "binding": "SESSION_KV", "id": "<staging-id>" }],
      // "routes": [{ "pattern": "api-staging.example.com", "custom_domain": true }]
    },
    "production": {
      "name": "guitar-api-production",
      "vars": {
        "TRUSTED_ORIGINS": "guitarmobileexpo://,https://example.com",
        "ENABLE_ANONYMOUS_AUTH": "true",
      },
      // "kv_namespaces": [{ "binding": "SESSION_KV", "id": "<production-id>" }],
      // "routes": [{ "pattern": "api.example.com", "custom_domain": true }]
    },
  },
}

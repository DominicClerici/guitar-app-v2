    "title": "Drill: Play the Chord Tones",
    "summary": "Play the C major triad in all five windows — whole where that is sensible, as a fragment where it is not — and then pick out every 3 on the neck."
  },
  "activity": {
    "kind": "note-play",
    "modes": ["easy", "hard"],
    "board": { "fretFrom": 0, "fretTo": 13 },

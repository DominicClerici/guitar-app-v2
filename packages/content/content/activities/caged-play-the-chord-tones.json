        "prompt": [
          { "text": "The C form, at the nut — the open " },
          { "text": "C", "marks": ["code"] },
          { "text": " chord. Five notes, strings 5 down to 1, degrees " },
          { "text": "1 3 5 1 3", "marks": ["code"] },
          { "text": ". Play them one at a time so the microphone can hear each one." }
        ],
        "targets": [
          { "string": 5, "fret": 3 },
          { "string": 4, "fret": 2 },
          { "string": 3, "fret": 0 },
          { "string": 2, "fret": 1 },
          { "string": 1, "fret": 0 }

          { "text": "1 5 1 3 5", "marks": ["code"] },
          { "text": " from string 5 up. Pick the strings separately." }
        ],
        "targets": [
          { "string": 5, "fret": 3 },
          { "string": 4, "fret": 5 },
          { "string": 3, "fret": 5 },
          { "string": 2, "fret": 5 },

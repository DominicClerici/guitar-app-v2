          { "text": "3·2", "marks": ["code"] },
          { "text": ", " },
          { "text": "1·5", "marks": ["code"] },
          { "text": " — then the two " },
          { "text": "D#", "marks": ["code"] },
          { "text": "s the window is named for. Anywhere A major would give you a " },
          { "text": "D", "marks": ["code"] },
          { "text": ", Lydian puts a " },
          { "text": "D#", "marks": ["code"] },
          { "text": " one fret higher." }
        ],
        "targets": [
          { "string": 6, "fret": 5 },

    "title": "Drill: Comp the Changes",
    "summary": "Four rhythms for the four-chord loop, from quarter notes to a sixteenth-note figure. Mute the strings — nothing here listens to which chord you played."
  },
  "activity": {
    "kind": "rhythm",
    "rounds": [
      {
        "kind": "pattern",
        "id": "r_triad-comp-the-changes.on-the-beat",
        "prompt": [
          {
            "text": "Rest your fretting hand flat across strings 1, 2 and 3 so nothing rings out — this drill only hears "
          },
          { "text": "when", "marks": ["italic"] },
          {
            "text": " you strike. Four bars of quarter notes, one bar per chord. Change grip on every downbeat even though the drill can't hear it: that is the part you are actually building."
          }
        ],
        "bpm": 80,
        "beatsPerBar": 4,
        "subdivision": 1,

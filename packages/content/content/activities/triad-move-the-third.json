{
  "schemaVersion": 1,
  "meta": {
    "id": "act_triad-move-the-third",
    "slug": "triad-move-the-third",
    "title": "Drill: Move the Third",
    "summary": "C minor in all three inversions on strings 1-2-3, including the one that had to climb an octave, and the three notes that are the whole chapter."
  },
  "activity": {
    "kind": "note-play",
    "modes": ["easy", "hard"],
    "board": { "fretFrom": 0, "fretTo": 13 },
    "rounds": [
      {
        "kind": "targets",
        "id": "r_triad-move-the-third.root",
        "prompt": [
          { "text": "C minor, root position: " },
          { "text": "x x x 5 4 3", "marks": ["code"] },
          { "text": " — " },
          { "text": "C", "marks": ["code"] },
          { "text": ", " },
          { "text": "Eb", "marks": ["code"] },
          { "text": ", " },
          { "text": "G", "marks": ["code"] },
          {
            "text": ". The major grip with the middle note pulled back one fret. Play the notes one at a time."
          }
        ],
        "targets": [
          { "string": 3, "fret": 5 },
          { "string": 2, "fret": 4 },
          { "string": 1, "fret": 3 }
        ]
      },
      {
        "kind": "targets",
        "id": "r_triad-move-the-third.first",
        "prompt": [
          { "text": "C minor, first inversion: " },
          { "text": "x x x 8 8 8", "marks": ["code"] },
          { "text": " — " },
          { "text": "Eb", "marks": ["code"] },
          { "text": ", " },
          { "text": "G", "marks": ["code"] },
          { "text": ", " },
          { "text": "C", "marks": ["code"] },
          {
            "text": ". The third is in the bass here, so dropping it moved the bottom of the grip and left all three notes at one fret."
          }
        ],
        "targets": [
          { "string": 3, "fret": 8 },
          { "string": 2, "fret": 8 },
          { "string": 1, "fret": 8 }
        ]
      },
      {
        "kind": "targets",
        "id": "r_triad-move-the-third.second",
        "prompt": [
          { "text": "C minor, second inversion: " },
          { "text": "x x x 12 13 11", "marks": ["code"] },
          { "text": " — " },
          { "text": "G", "marks": ["code"] },
          { "text": ", " },
          { "text": "C", "marks": ["code"] },
          { "text": ", " },
          { "text": "Eb", "marks": ["code"] },
          {
            "text": ". The one that had to climb: the flat third it wants sits below the open high e, so the whole grip waits an octave."
          }
        ],
        "targets": [
          { "string": 3, "fret": 12 },
          { "string": 2, "fret": 13 },
          { "string": 1, "fret": 11 }
        ]
      },
      {
        "kind": "targets",
        "id": "r_triad-move-the-third.the-drop",
        "prompt": [
          {
            "text": "Three notes, in this order: the root, then the major third, then the minor third — "
          },
          { "text": "3·5", "marks": ["code"] },
          { "text": ", " },
          { "text": "2·5", "marks": ["code"] },
          { "text": ", " },
          { "text": "2·4", "marks": ["code"] },
          {
            "text": ". One finger back a fret, and that is the whole difference between the two chords. Listen to it rather than watching it."
          }
        ],
        "targets": [
          { "string": 3, "fret": 5 },
          { "string": 2, "fret": 5 },
          { "string": 2, "fret": 4 }
        ],
        "ordered": true
      }
    ]
  }

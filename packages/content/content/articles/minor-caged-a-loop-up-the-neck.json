    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Read down that table for a span every chord shares. Three of the four have a window at exactly frets "
        },
        {
          "text": "2–6",
          "marks": ["code"]
        },
        {
          "text": " — "
        },
        {
          "text": "C",
          "marks": ["code"]
        },
        {
          "text": "'s A form, "
        },
        {
          "text": "G",
          "marks": ["code"]
        },
        {
          "text": "'s E form, and "
        },
        {
          "text": "F",
          "marks": ["code"]
        },
        {
          "text": "'s D form. "
        },
        {
          "text": "Am",
          "marks": ["code"]
        },
        {
          "text": " doesn't; its nearest is the E form at "
        },
        {
          "text": "4–8",
          "marks": ["code"]
        },
        {
          "text": ". That gives a second route, tighter than the first:"
        }

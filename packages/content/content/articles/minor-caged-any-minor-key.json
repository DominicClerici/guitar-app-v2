        {
          "text": "0–3",
          "marks": ["code"]
        },
        {
          "text": "; "
        },
        {
          "text": "D",
          "marks": ["code"]
        },
        {
          "text": " sits at fret "
        },
        {
          "text": "10",
          "marks": ["code"]
        },
        {
          "text": ", and D minor's E form is "
        },
        {
          "text": "9–13",
          "marks": ["code"]
        },
        {
          "text": "."
        }
      ]
    },
    {

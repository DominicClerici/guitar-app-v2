    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Character in the reach, too. Its three-fret strings are 3 and 2, right in the middle of the hand, and they're the two that straddle the "
        },
        {
          "text": "G → B",
          "marks": ["code"]

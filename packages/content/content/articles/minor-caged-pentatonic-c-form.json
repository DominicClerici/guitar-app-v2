      "spans": [
        {
          "text": "One reminder before the dots, since you may be arriving after a gap: "
        },
        {
          "text": "5·3",
          "marks": ["code"]
        },
        {
          "text": " means string 5, fret 3 — string 1 is the high "
        },
        {
          "text": "e",
          "marks": ["code"]
        },
        {
          "text": ", string 6 the low "
        },
        {
          "text": "E",
          "marks": ["code"]
        },
        {
          "text": ". The C form's window is frets "
        },
        {
          "text": "9–13",
          "marks": ["code"]
        },
        {
          "text": ", the highest of the five, and the same window chapter 2's C form worked in."
        }

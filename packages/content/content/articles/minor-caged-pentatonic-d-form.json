      "type": "paragraph",
      "spans": [
        {
          "text": "The D form of A minor is "
        },
        {
          "text": "the Dm shape at fret 7",
          "link": {
            "kind": "article",
            "slug": "minor-caged-triad-d-form"
          }
        },
        {
          "text": ". Its pentatonic window runs frets "
        },
        {
          "text": "6–10",
          "marks": ["code"]
        },
        {
          "text": ", and its twelve dots sit on frets "
        },
        {
          "text": "7",
          "marks": ["code"]
        },

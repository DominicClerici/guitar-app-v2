    {
      "type": "paragraph",
      "spans": [
        {
          "text": "The two chords share no notes at all — "
        },
        {
          "text": "Am",
          "marks": ["code"]
        },
        {
          "text": " is "
        },
        {
          "text": "A C E",
          "marks": ["code"]
        },
        {
          "text": ", "
        },
        {
          "text": "Bb",
          "marks": ["code"]

    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Two of these rows land on the same second chord — "
        },
        {
          "text": "Em",
          "marks": ["code"]
        },
        {
          "text": "–"
        },
        {
          "text": "F",
          "marks": ["code"]
        },
        {
          "text": " and "
        },
        {
          "text": "G",
          "marks": ["code"]
        },
        {
          "text": "–"
        },
        {
          "text": "F",
          "marks": ["code"]
        },
        {
          "text": " — and they're different modes anyway. "
        },
        {
          "text": "F",
          "marks": ["code"]
        },
        {
          "text": " carries the "
        },
        {
          "text": "b2",
          "marks": [
            "code",

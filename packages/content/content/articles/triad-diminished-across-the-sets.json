    },
    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Diminished's three inversions aren't one shape recycled, and the arithmetic says why. The gaps are "
        },
        {
          "text": "3",
          "marks": ["code"]
        },
        {
          "text": " semitones up to the "
        },
        {
          "text": "b3",
          "marks": ["code"]
        },
        {
          "text": ", "
        },
        {
          "text": "3",
          "marks": ["code"]
        },
        {
          "text": " more up to the "
        },
        {
          "text": "b5",
          "marks": ["code"]
        },
        {
          "text": ", and "
        },
        {
          "text": "6",
          "marks": ["code"]
        },
        {
          "text": " back to the root — so the rotations are "
        },
        {
          "text": "3+3",
          "marks": ["code"]

      }
    },
    {
      "type": "paragraph",
      "spans": [
        { "text": "Follow the bands to fret 12 and second inversion comes back: " },
        { "text": "x x x 12 13 12", "marks": ["code"] },
        { "text": ", the same " },
        { "text": "G C E", "marks": ["code"] },
        {
          "text": " an octave up. The cycle doesn't run out at the top of this pattern — it starts over, and everything above fret 12 on this set is just this same climb again, higher."
        }
      ]
    },

    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Predict before you check. Moving from strings 1-2-3 to strings 2-3-4, the correction was the middle note, one fret lower. Moving down again, to strings 3-4-5, that pattern breaks: the middle note stays exactly where the 2-3-4 shape put it, and this time it's the "
        },
        { "text": "top", "marks": ["italic"] },
        { "text": " note that comes down a fret." }
      ]
    },
    {
      "type": "paragraph",
      "spans": [{ "text": "Root position sits at the bottom of this set." }]

      ]
    },
    {
      "type": "callout",
      "tone": "warning",
      "spans": [
        { "text": "Not every open chord works this way. Open G is " },
        { "text": "3 2 0 0 0 3", "marks": ["code"] },
        { "text": "; its top three strings, " },
        { "text": "0 0 3", "marks": ["code"] },
        { "text": ", are " },
        { "text": "G", "marks": ["code"] },
        { "text": " " },
        { "text": "B", "marks": ["code"] },
        { "text": " " },
        { "text": "G", "marks": ["code"] },
        {
          "text": " — root, third, root. No fifth, and a doubled root: not a triad. A doubled root can sound full and still be missing a note. Read the top three strings of any chord you like, but check before you trust it."
        }
      ]
    },

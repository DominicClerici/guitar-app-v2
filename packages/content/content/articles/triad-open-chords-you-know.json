      "spans": [
        { "text": "3·2", "marks": ["code"] },
        { "text": " is " },
        { "text": "A", "marks": ["code"] },
        { "text": ", " },
        { "text": "2·3", "marks": ["code"] },
        { "text": " is " },
        { "text": "D", "marks": ["code"] },
        { "text": ", " },
        { "text": "1·2", "marks": ["code"] },
        { "text": " is " },
        { "text": "F#", "marks": ["code"] },
        { "text": ". Degrees " },

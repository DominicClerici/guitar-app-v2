    },
    {
      "type": "paragraph",
      "spans": [
        { "text": "Open D borrows the same three strings for a different inversion. " },
        { "text": "x x 0 2 3 2", "marks": ["code"] },
        { "text": " — top three strings " },
        { "text": "2 3 2", "marks": ["code"] },
        { "text": " — are " },
        { "text": "A", "marks": ["code"] },
        { "text": " " },
        { "text": "D", "marks": ["code"] },
        { "text": " " },
        { "text": "F#", "marks": ["code"] },
        { "text": ". The bass is " },
        { "text": "A", "marks": ["code"] },
        { "text": ", but the chord is still " },
        { "text": "D", "marks": ["code"] },
        { "text": ": a " },
        { "text": "D/A", "marks": ["code"] },
        { "text": ", second inversion, the fifth sitting underneath." }
      ]
    },

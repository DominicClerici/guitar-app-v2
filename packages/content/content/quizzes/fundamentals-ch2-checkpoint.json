{
  "schemaVersion": 1,
  "meta": {
    "id": "quiz_fundamentals-ch2-checkpoint",
    "slug": "fundamentals-ch2-checkpoint",
    "title": "Checkpoint: Scales and Chords",
    "summary": "Six questions on triads, the third, and what separates a parallel major from its minor.",
    "kind": "checkpoint",
    "passThresholdPct": 70
  },
  "questions": [
    {
      "id": "q_fundamentals-ch2-checkpoint.triad-degrees",
      "kind": "choice",
      "prompt": [{ "text": "Which scale degrees make a basic triad?" }],
      "options": [
        { "id": "a", "spans": [{ "text": "1, 2, 3", "marks": ["code"] }] },
        { "id": "b", "spans": [{ "text": "1, 3, 5", "marks": ["code"] }] },
        { "id": "c", "spans": [{ "text": "1, 4, 5", "marks": ["code"] }] },
        { "id": "d", "spans": [{ "text": "1, 5, 7", "marks": ["code"] }] }
      ],
      "answerId": "b",
      "explanation": [
        { "text": "Take every other degree — 1, 3, 5 — and you have stacked two thirds." }
      ]
    },
    {
      "id": "q_fundamentals-ch2-checkpoint.major-stack",
      "kind": "choice",
      "prompt": [
        { "text": "Counting up from the root, how is a " },
        { "text": "major", "marks": ["bold"] },
        { "text": " triad stacked?" }
      ],
      "options": [
        { "id": "a", "spans": [{ "text": "3 frets, then 4" }] },
        { "id": "b", "spans": [{ "text": "4 frets, then 3" }] },
        { "id": "c", "spans": [{ "text": "3 frets, then 3" }] },
        { "id": "d", "spans": [{ "text": "4 frets, then 4" }] }
      ],
      "answerId": "b",
      "explanation": [
        { "text": "Major is the big gap first: " },
        { "text": "C→E", "marks": ["code"] },
        { "text": " is four frets, " },
        { "text": "E→G", "marks": ["code"] },
        { "text": " is three. Reverse them and you get a minor triad." }
      ]
    },
    {
      "id": "q_fundamentals-ch2-checkpoint.em-notes",
      "kind": "multi-select",
      "prompt": [
        { "text": "An open " },
        { "text": "E minor", "marks": ["code"] },
        { "text": " rings all six strings. Which note names does it actually contain?" }
      ],
      "options": [
        { "id": "e", "spans": [{ "text": "E", "marks": ["code"] }] },
        { "id": "g", "spans": [{ "text": "G", "marks": ["code"] }] },
        { "id": "b", "spans": [{ "text": "B", "marks": ["code"] }] },
        { "id": "d", "spans": [{ "text": "D", "marks": ["code"] }] },
        { "id": "a", "spans": [{ "text": "A", "marks": ["code"] }] }
      ],
      "answerIds": ["e", "g", "b"],
      "explanation": [
        {
          "text": "Three note names across six strings. The rest is doubling — the same notes in different octaves, which is what makes a strum sound big."
        }
      ]
    },
    {
      "id": "q_fundamentals-ch2-checkpoint.parallel-differences",
      "kind": "multi-select",
      "prompt": [
        {
          "text": "Compared with the major scale on the same root, which degrees does the natural minor lower?"
        }
      ],
      "options": [
        { "id": "second", "spans": [{ "text": "The 2nd" }] },
        { "id": "third", "spans": [{ "text": "The 3rd" }] },
        { "id": "fifth", "spans": [{ "text": "The 5th" }] },
        { "id": "sixth", "spans": [{ "text": "The 6th" }] },
        { "id": "seventh", "spans": [{ "text": "The 7th" }] }
      ],
      "answerIds": ["third", "sixth", "seventh"],
      "explanation": [
        { "text": "Three notes: " },
        { "text": "b3", "marks": ["code"] },
        { "text": ", " },
        { "text": "b6", "marks": ["code"] },
        { "text": " and " },
        { "text": "b7", "marks": ["code"] },
        { "text": ". The third is the one you hear first." }
      ]
    },
    {
      "id": "q_fundamentals-ch2-checkpoint.c-to-cm",
      "kind": "choice",
      "prompt": [
        { "text": "You are holding a " },
        { "text": "C E G", "marks": ["code"] },
        { "text": " triad. Which single change makes it minor?" }
      ],
      "options": [
        { "id": "a", "spans": [{ "text": "Lower the E by one fret" }] },
        { "id": "b", "spans": [{ "text": "Lower the G by one fret" }] },
        { "id": "c", "spans": [{ "text": "Raise the C by one fret" }] },
        { "id": "d", "spans": [{ "text": "Remove the G" }] }
      ],
      "answerId": "a",
      "explanation": [
        { "text": "The third does the work: " },
        { "text": "E", "marks": ["code"] },
        { "text": " becomes " },
        { "text": "Eb", "marks": ["code"] },
        { "text": " and the chord turns inward." }
      ]
    },
    {
      "id": "q_fundamentals-ch2-checkpoint.mixolydian",
      "kind": "choice",
      "prompt": [{ "text": "Mixolydian is the major scale with one note moved. Which one?" }],
      "options": [
        { "id": "a", "spans": [{ "text": "A lowered 3rd" }] },
        { "id": "b", "spans": [{ "text": "A lowered 6th" }] },
        { "id": "c", "spans": [{ "text": "A lowered 7th" }] },
        { "id": "d", "spans": [{ "text": "A raised 4th" }] }
      ],
      "answerId": "c",
      "explanation": [
        {
          "text": "One fret on the seventh degree, and a scale that resolves becomes a scale that grooves."
        }
      ]
    }
  ]
}

      "options": [
        {
          "id": "a",
          "spans": [
            {
              "text": "Every grip is different, but the number of frets each string moves on every change is exactly the same."
            }
          ]
        },
        {
          "id": "b",
          "spans": [
            {
              "text": "Both change — the B string shifts one of the notes, so the movement has to be relearned."
            }

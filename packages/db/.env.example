# Copy to `.env` (gitignored). `pnpm db:migrate` and `drizzle-kit` read this.

# Local development, against the containers in docker-compose.yml (`pnpm db:up`).
# The host being local is what makes the driver route through the HTTP proxy on :4444 instead of
# reaching for Neon, so keep it as localhost.
DATABASE_URL=postgres://guitar:guitar@localhost:5433/guitar

# Deployed: the Neon connection string for the branch you are targeting.
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/guitar?sslmode=require

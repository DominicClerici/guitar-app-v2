{
  "name": "@guitar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.pg": "./src/schema.pg.ts",
    "./schema.sqlite": "./src/schema.sqlite.ts"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
